{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnippetDeck",
  "version": "1.8.0",
  "identifier": "io.github.krablante.snippetdeck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Local text expansion with portable snippets",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": ["libxdo3"]
      }
    }
  }
}
