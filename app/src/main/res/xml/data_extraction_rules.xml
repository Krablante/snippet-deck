<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include shared preferences for backup -->
        <include domain="sharedpref" path="expander_prefs.xml"/>
        <include domain="sharedpref" path="theme_prefs.xml"/>

        <!-- Include database for snippets backup -->
        <!-- Room's expander_database and journal sidecars; no sync identity or tokens. -->
        <include domain="database" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Include shared preferences for device transfer -->
        <include domain="sharedpref" path="expander_prefs.xml"/>
        <include domain="sharedpref" path="theme_prefs.xml"/>

        <!-- Include database for snippets transfer -->
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
